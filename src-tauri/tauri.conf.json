{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Splice It",
  "version": "0.2.8",
  "identifier": "com.kmab.spliceit",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Splice It - Desktop Audio Workspace",
        "width": 1440,
        "height": 900,
        "minWidth": 1024,
        "minHeight": 700,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": [
          "sic",
          "audioproj"
        ],
        "name": "Splice It Project",
        "description": "Splice It Workspace Project File",
        "role": "Editor"
      }
    ]
  }
}
